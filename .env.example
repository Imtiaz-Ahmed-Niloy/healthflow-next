# HealthFlow — environment template
# Copy to .env.local and fill in. Ask Ridwan for the values.
#
#   cp .env.example .env.local
#
# The Supabase project is "healthflow" under the Health Flow BD org.

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Server-only. Bypasses RLS entirely — never expose to the browser,
# never prefix with NEXT_PUBLIC_, never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Project ref, for Supabase CLI commands.
SUPABASE_PROJECT_REF=<project-ref>
