# HealthFlow — environment template
# Copy to .env.local and fill in. Ask Ridwan for the values.
#
#   cp .env.example .env.local
#
# The Supabase project is "healthflow" under the Health Flow BD org.

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Server-only. Bypasses RLS entirely — never expose to the browser,
# never prefix with NEXT_PUBLIC_, never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Project ref, for Supabase CLI commands.
SUPABASE_PROJECT_REF=<project-ref>

# Server-only. Encrypts (not hashes) generated doctor login passwords so an
# admin can view one again later (HF-32) — see src/lib/credentials.ts.
# 32 raw bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing/rotating this makes every password stored under the old key
# unreadable — regenerate those logins rather than trying to recover them.
DOCTOR_LOGIN_ENCRYPTION_KEY=

# Server-only, optional. IPinfo (ipinfo.io) access token — guesses a visitor's
# district from their IP address for "doctors near you" (src/server/geo.ts).
# Without it the guess still works, for about a thousand lookups a day.
IPINFO_TOKEN=

# Public, optional. A Google Maps key for a hospital's directions page
# (src/views/patient/HospitalDirections.tsx), with three APIs enabled on it:
#   - "Places API (New)" — place suggestions as the patient types where they
#     are starting from. Billed by Google past its free monthly amount.
#   - "Routes API" — the distance and travel time card. Billed the same way.
#   - "Maps Embed API" — the map itself. Free.
# Without the key the page still works: the map is Google's keyless embed, the
# suggestions are our own districts and upazilas, and the distance and time
# card is left out. It ships in the browser bundle, so in Google Cloud
# restrict it to the site's own address (https://healthflowbd.com/*, and
# http://localhost:3000/* for development) and to those three APIs.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Cloudflare R2 — image uploads (hospital logos, doctor photos).
# Setup and where each value comes from: docs/image-uploads-r2.md
# Without these the app runs normally; only uploading returns a 503.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Public — the bucket's r2.dev address, e.g. https://pub-xxxxxxxx.r2.dev
# We store object keys, not URLs, so this can change to a custom domain later
# without touching a single saved row.
NEXT_PUBLIC_R2_PUBLIC_URL=
